#!/bin/sh
# Audit repository tool: runs src/auditrepo/main.ts of the framework pinned at harness/ (see harness/docs/audit-repo.md).
self=$(readlink -f -- "$0" 2>/dev/null || printf '%s\n' "$0")
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd -P) || exit 1
if [ ! -f "$root/harness/bin/harness" ]; then
  git -C "$root" submodule update --init harness >&2 || { echo "audit: no framework at harness/" >&2; exit 1; }
fi
AUDIT_ROOT=$root exec node "$root/harness/src/auditrepo/main.ts" "$@"
